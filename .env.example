# Copy this file to .env and fill in your key. .env is gitignored.
#
# LOCAL ONLY: get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-ai-studio-key-here

# Optional: override the Gemini model without editing code. The free tier allows
# 20 requests per day PER MODEL, and one chat turn costs about two — so when one
# runs out, move to the next line rather than waiting for the daily reset.
# BARISTA_MODEL=gemini-3.7-flash
# BARISTA_MODEL=gemini-3.6-flash
# BARISTA_MODEL=gemini-3.5-flash        (the default if this is unset)
# BARISTA_MODEL=gemini-3.5-flash-lite
# BARISTA_MODEL=gemini-3.1-flash-lite
#
# The quota day is a US-Pacific day, not yours: buckets reset at midnight PT.
# An evening session and the next morning's can be the same quota day.

# Do NOT set the variables below locally — Cloud Run sets them at deploy time
# so the same code authenticates through the runtime service account instead:
#   GOOGLE_GENAI_USE_VERTEXAI=TRUE
#   GOOGLE_CLOUD_PROJECT=<your-project-id>
#   GOOGLE_CLOUD_LOCATION=global
