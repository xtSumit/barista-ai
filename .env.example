# Copy this file to .env and fill in your key. .env is gitignored.
#
# LOCAL ONLY: get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-ai-studio-key-here

# Optional: override the Gemini model without editing code.
# BARISTA_MODEL=gemini-3.7-flash   (alternatives if 3.5 throttles)

# Do NOT set the variables below locally — Cloud Run sets them at deploy time
# so the same code authenticates through the runtime service account instead:
#   GOOGLE_GENAI_USE_VERTEXAI=TRUE
#   GOOGLE_CLOUD_PROJECT=<your-project-id>
#   GOOGLE_CLOUD_LOCATION=global
